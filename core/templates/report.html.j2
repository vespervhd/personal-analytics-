<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ direction }}">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: Tahoma, 'Vazirmatn', system-ui, sans-serif; max-width: 960px; margin: 2rem auto;
         padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  h1 { font-size: 1.6rem; } h2 { margin-top: 2rem; font-size: 1.2rem; }
  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0; }
  th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
  [dir="rtl"] th, [dir="rtl"] td { text-align: right; }
  th { background: #f0f0f0; }
  .note { color: #555; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<p class="note">{{ labels.generated_by }}</p>

<h2>{{ labels.overview }}</h2>
<table>
{% for label, value in overview %}
  <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
{% endfor %}
</table>

<h2>{{ labels.quality }}</h2>
<table>
  <tr><th>{{ labels.column }}</th><th>{{ labels.missing }}</th><th>{{ labels.missing_pct }}</th></tr>
{% for column, info in missing.columns.items() %}
  <tr><td>{{ column }}</td><td>{{ info.missing }}</td><td>{{ info.percent }}</td></tr>
{% endfor %}
</table>
<p>{{ labels.missing }}: {{ missing.total_missing }} ({{ missing.total_percent }}%).</p>

<h2>{{ labels.stats }}</h2>
<table>
  <tr><th>{{ labels.column }}</th><th>{{ labels.type }}</th><th>{{ labels.mean }}</th><th>{{ labels.median }}</th><th>{{ labels.std }}</th><th>{{ labels.min }}</th><th>{{ labels.max }}</th><th>{{ labels.unique }}</th></tr>
{% for column, summary in columns.items() %}
  <tr>
    <td>{{ column }}</td><td>{{ summary.type }}</td>
    <td>{{ summary.mean if summary.mean is not none else "—" }}</td>
    <td>{{ summary.median if summary.median is not none else "—" }}</td>
    <td>{{ summary.std if summary.std is not none else "—" }}</td>
    <td>{{ summary.min if summary.min is not none else "—" }}</td>
    <td>{{ summary.max if summary.max is not none else "—" }}</td>
    <td>{{ summary.unique if summary.unique is not none else "—" }}</td>
  </tr>
{% endfor %}
</table>

<h2>{{ labels.anomalies }}</h2>
{% if anomalies %}
<p>{{ anomaly_line }}</p>
{% if anomalies.anomaly_rows %}
<table>
  <tr>{% for key in anomalies.anomaly_rows[0] %}<th>{{ key }}</th>{% endfor %}</tr>
  {% for row in anomalies.anomaly_rows %}
  <tr>{% for value in row.values() %}<td>{{ value }}</td>{% endfor %}</tr>
  {% endfor %}
</table>
{% endif %}
{% else %}
<p class="note">{{ no_anomaly_note }}</p>
{% endif %}

<h2>{{ labels.insights }}</h2>
<ul>
{% for insight in insights %}
  <li>{{ insight }}</li>
{% endfor %}
</ul>

{% for chart in charts_html %}
<h2>{{ labels.chart }}</h2>
{{ chart | safe }}
{% endfor %}
</body>
</html>
