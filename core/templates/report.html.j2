<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto;
         padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  h1 { font-size: 1.6rem; } h2 { margin-top: 2rem; font-size: 1.2rem; }
  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0; }
  th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
  th { background: #f0f0f0; }
  .note { color: #555; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<p class="note">Generated by the Personal Data Analytics Platform.</p>

<h2>Dataset overview</h2>
<table>
{% for key, value in overview.items() %}
  <tr><th>{{ key }}</th><td>{{ value }}</td></tr>
{% endfor %}
</table>

<h2>Data quality assessment</h2>
<table>
  <tr><th>Column</th><th>Missing</th><th>Missing %</th></tr>
{% for column, info in missing.columns.items() %}
  <tr><td>{{ column }}</td><td>{{ info.missing }}</td><td>{{ info.percent }}</td></tr>
{% endfor %}
</table>
<p>Total missing cells: {{ missing.total_missing }} ({{ missing.total_percent }}%).</p>

<h2>Statistical summaries</h2>
<table>
  <tr><th>Column</th><th>Type</th><th>Mean</th><th>Median</th><th>Std</th><th>Min</th><th>Max</th><th>Unique</th></tr>
{% for column, summary in columns.items() %}
  <tr>
    <td>{{ column }}</td><td>{{ summary.type }}</td>
    <td>{{ summary.mean if summary.mean is not none else "—" }}</td>
    <td>{{ summary.median if summary.median is not none else "—" }}</td>
    <td>{{ summary.std if summary.std is not none else "—" }}</td>
    <td>{{ summary.min if summary.min is not none else "—" }}</td>
    <td>{{ summary.max if summary.max is not none else "—" }}</td>
    <td>{{ summary.unique if summary.unique is not none else "—" }}</td>
  </tr>
{% endfor %}
</table>

<h2>Detected anomalies</h2>
{% if anomalies %}
<p>Method: {{ anomalies.method }} — {{ anomalies.anomalies }} anomalies found
in {{ anomalies.rows_analysed }} analysed rows.</p>
{% if anomalies.anomaly_rows %}
<table>
  <tr>{% for key in anomalies.anomaly_rows[0] %}<th>{{ key }}</th>{% endfor %}</tr>
  {% for row in anomalies.anomaly_rows %}
  <tr>{% for value in row.values() %}<td>{{ value }}</td>{% endfor %}</tr>
  {% endfor %}
</table>
{% endif %}
{% else %}
<p class="note">No anomaly detection was run for this report.</p>
{% endif %}

<h2>Key insights</h2>
<ul>
{% for insight in insights %}
  <li>{{ insight }}</li>
{% endfor %}
</ul>

{% for chart in charts_html %}
<h2>Chart</h2>
{{ chart | safe }}
{% endfor %}
</body>
</html>
